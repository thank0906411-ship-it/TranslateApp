<?xml version="1.0" encoding="utf-8"?>
<!--
    이 앱은 WebView로 사용자가 입력한 임의의 사이트를 그대로 띄우므로(HTTP만 지원하는
    구식 사이트도 있을 수 있음), 기본 도메인 설정(base-config)은 cleartext(평문 HTTP)를
    허용해 어떤 사이트든 열 수 있게 한다.

    반면 앱 자체가 통신하는 API 서버들(GitHub, Google Cloud Translation, Anthropic,
    OpenAI)은 전부 HTTPS만 제공하므로 실질적으로 평문으로 통신할 일이 없지만,
    domain-config로 명시적으로 cleartextTrafficPermitted="false"를 걸어두면 만약의
    다운그레이드 공격(예: 악성 프록시가 이 도메인들에 대한 요청을 HTTP로 유도)
    시도가 있어도 시스템이 자체적으로 차단해준다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">translation.googleapis.com</domain>
        <domain includeSubdomains="true">api.anthropic.com</domain>
        <domain includeSubdomains="true">api.openai.com</domain>
    </domain-config>
</network-security-config>
